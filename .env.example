# =============================================================================
# RaspberryPros - variables de entorno del stack de Docker
# -----------------------------------------------------------------------------
# Copiar este archivo como .env y cambiar las contrasenas ANTES de levantar:
#
#   cp .env.example .env
#
# El archivo .env NO se sube al repositorio (esta en .gitignore).
# =============================================================================

# ---------- PostgreSQL ----------
POSTGRES_USER=postgres
# Obligatoria. Cambiar por una contrasena propia.
POSTGRES_PASSWORD=cambia_esta_contrasena

# ---------- Microservicio Usuarios ----------
# Obligatoria. Generar una cadena larga y aleatoria, por ejemplo con:
#   openssl rand -base64 48
JWT_SECRET=cambia_este_secreto_por_uno_aleatorio_y_largo
JWT_EXPIRES_IN=1h
BCRYPT_SALT_ROUNDS=12

# ---------- Microservicio Ventas ----------
UPSTREAM_TIMEOUT_MS=5000

# ---------- Frontend ----------
# Puerto de la Raspberry Pi por el que se entra a la aplicacion:
#   http://<ip-de-la-raspberry>:8080
FRONTEND_PORT=8080

# ---------- Extras ----------
# true = crea el usuario de prueba test@example.com / Password123!
# Solo tiene efecto la primera vez que se inicializa la base de datos.
SEED_DEMO_DATA=false

TZ=America/Guatemala
